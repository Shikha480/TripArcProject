# Path to the app file (download from https://github.com/saucelabs/my-demo-app-android/releases)
ANDROID_APP_PATH=./apps/mda.apk

# Optional: ID from `adb devices`, to pick one device when several are connected
ANDROID_UDID=

# Optional: leave empty to accept any Android version
ANDROID_PLATFORM_VERSION=

# How long to wait for elements (milliseconds)
WAIT_TIMEOUT=15000
